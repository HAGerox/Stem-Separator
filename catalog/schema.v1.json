{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemseparator.app/catalog/schema.v1.json",
  "title": "Stem Separator model catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "models", "recommendations", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceLabel": { "type": "string" },
    "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
    "recommendations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/capabilityId" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/capabilityId" },
      "additionalProperties": { "$ref": "#/$defs/capability" }
    },
    "promoted": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityId" },
      "uniqueItems": true
    },
    "groups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "multiTrack": {
      "type": "object",
      "required": ["modelId", "stems"],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "stems": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityId" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "runtimeKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+$"
    },
    "artifact": {
      "type": "object",
      "required": ["name", "url", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "output": {
      "type": "object",
      "required": ["capability", "runtimeKey"],
      "properties": {
        "capability": { "$ref": "#/$defs/capabilityId" },
        "runtimeKey": { "$ref": "#/$defs/runtimeKey" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id", "filename", "name", "architecture", "stems", "quality", "speed",
        "memory", "status", "runtimeValidated", "outputs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "stems": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "quality": { "type": "number", "minimum": 0, "maximum": 100 },
        "speed": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory": { "enum": ["low", "medium", "high"] },
        "note": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "status": { "type": "string", "minLength": 1 },
        "runtimeValidated": { "const": true },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/output" },
          "minItems": 1
        }
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "label", "kind", "group", "groupLabel"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["stem", "complement", "preset", "transform", "workflow"] },
        "group": { "type": "string", "minLength": 1 },
        "groupLabel": { "type": "string", "minLength": 1 },
        "glyph": { "type": "string", "minLength": 1 },
        "promoted": { "type": "boolean" }
      }
    }
  }
}
