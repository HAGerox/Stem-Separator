{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stem Separator",
  "version": "0.3.0",
  "identifier": "com.stemseparator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Stem Separator",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Effortless, intelligent audio stem separation.",
    "longDescription": "Separate vocals, instruments, and production stems with automatic model selection.",
    "resources": {
      "resources/": ""
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NThGQzc2Qzg0NDE2ODUKUldTRkZrVElkdnhZUmlwMVAyZUVQS1hPTVZYZkZpdEJKaC9pODNaQ1NjMHY5eU1USTdYR0pMTncK",
      "endpoints": [
        "https://github.com/HAGerox/Stem-Separator/releases/latest/download/latest.json"
      ]
    }
  }
}
