{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stem Separator",
  "version": "0.1.3",
  "identifier": "com.stemseparator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Stem Separator",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Effortless, intelligent audio stem separation.",
    "longDescription": "Separate vocals, instruments, and production stems with automatic model selection.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
